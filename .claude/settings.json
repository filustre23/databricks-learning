      "Bash(databricks bundle destroy*)",
      "Bash(databricks fs cp*)",
      "Bash(databricks fs rm*)",
      "Bash(databricks jobs run-now*)",
      "Bash(databricks jobs repair-run*)",
      "Bash(databricks pipelines start-update*)",
      "Bash(aws s3 cp*)",
      "Bash(aws s3 mv*)",
      "Bash(aws s3 rm*)",
      "Bash(aws s3 sync*)",
      "Bash(git push*)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.tfstate*)",
      "Read(~/.databrickscfg)"
