      "Bash(databricks tables list*)",
      "Bash(databricks tables get*)",
      "Bash(databricks volumes list*)",
      "Bash(databricks volumes read*)",
      "Bash(databricks grants get*)",
      "Bash(databricks external-locations list*)",
      "Bash(databricks storage-credentials list*)",
      "Bash(databricks warehouses list*)",
      "Bash(databricks warehouses get*)",
      "Bash(databricks jobs list*)",
      "Bash(databricks jobs get*)",
      "Bash(databricks pipelines list*)",
      "Bash(databricks pipelines get*)",
      "Bash(databricks alerts list*)",
      "Bash(databricks alerts get*)",
      "Bash(databricks fs ls*)",
      "Bash(databricks bundle validate*)",
      "Bash(databricks bundle summary*)",
      "Bash(databricks account workspaces list*)",
      "Bash(databricks account metastores list*)",
      "Bash(terraform version)",
